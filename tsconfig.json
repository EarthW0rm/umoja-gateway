{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@core/core": [
        "libs/core/src"
      ],
      "@core/core/*": [
        "libs/core/src/*"
      ],
      "@oauth/oauth": [
        "libs/oauth/src"
      ],
      "@oauth/oauth/*": [
        "libs/oauth/src/*"
      ]
    }
  }
}