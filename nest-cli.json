{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/umoja-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/umoja-gateway/tsconfig.app.json"
  },
  "projects": {
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "umoja-api": {
      "type": "application",
      "root": "apps/umoja-api",
      "entryFile": "main",
      "sourceRoot": "apps/umoja-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/umoja-api/tsconfig.app.json"
      }
    },
    "umoja-gateway": {
      "type": "application",
      "root": "apps/umoja-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/umoja-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/umoja-gateway/tsconfig.app.json"
      }
    }
  },
  "monorepo": true,
  "root": "apps/umoja-gateway"
}