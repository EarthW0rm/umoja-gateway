{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/umoja-api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/umoja-api/tsconfig.app.json"
  },
  "projects": {
    "control-plane": {
      "type": "library",
      "root": "libs/control-plane",
      "entryFile": "index",
      "sourceRoot": "libs/control-plane/src",
      "compilerOptions": {
        "tsConfigPath": "libs/control-plane/tsconfig.lib.json"
      }
    },
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "oauth": {
      "type": "library",
      "root": "libs/oauth",
      "entryFile": "index",
      "sourceRoot": "libs/oauth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/oauth/tsconfig.lib.json"
      }
    },
    "umoja-api": {
      "type": "application",
      "root": "apps/umoja-api",
      "entryFile": "main",
      "sourceRoot": "apps/umoja-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/umoja-api/tsconfig.app.json"
      }
    }
  },
  "monorepo": true,
  "root": "apps/umoja-api"
}