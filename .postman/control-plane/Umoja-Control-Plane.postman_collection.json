    {
      "name": "Test Scenarios (Negative)",
      "description": "Expect 401/403 or 404 when auth is missing or resource not found.",
      "item": [
        {
          "name": "[Negative] OAuth Clients without token (if permission required)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const code = pm.response.code;",
                  "pm.test('Status is 403 or 200', () => pm.expect([200, 403]).to.include(code));"
                ],
