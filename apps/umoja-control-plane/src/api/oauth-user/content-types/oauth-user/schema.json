{
  "kind": "collectionType",
  "collectionName": "oauth_users",
  "info": {
    "singularName": "oauth-user",
    "pluralName": "oauth-users",
    "displayName": "OAuth User"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "password": {
      "type": "string",
      "required": true
    },
    "audiences": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::oauth-audience.oauth-audience",
      "inversedBy": "users"
    },
    "clients": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::oauth-client.oauth-client",
      "mappedBy": "user"
    },
    "tokens": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::oauth-token.oauth-token",
      "mappedBy": "user"
    },
    "refreshTokens": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::oauth-refresh-token.oauth-refresh-token",
      "mappedBy": "user"
    },
    "authorizationCodes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::oauth-authorization-code.oauth-authorization-code",
      "mappedBy": "user"
    }
  }
}
