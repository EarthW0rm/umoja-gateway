{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@oauth/oauth(|/.*)$": "<rootDir>/../../../libs/oauth/src/$1",
    "^@core/core(|/.*)$": "<rootDir>/../../../libs/core/src/$1"
  }
}
